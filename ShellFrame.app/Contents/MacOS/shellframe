#!/bin/bash
# ShellFrame launcher — runs source directly with full user environment
# Source user profile for PATH (nvm, .local/bin, etc.)
if [ -f "$HOME/.zprofile" ]; then source "$HOME/.zprofile"; fi
if [ -f "$HOME/.zshrc" ]; then source "$HOME/.zshrc" 2>/dev/null; fi

# Resolve real path through symlinks (~/Applications/ShellFrame.app is a symlink)
SELF="$0"
if [ -L "$SELF" ]; then
  SELF="$(readlink "$SELF")"
fi
DIR="$(cd "$(dirname "$SELF")/../../.." 2>/dev/null && pwd)"

# If DIR doesn't have .venv, try the hardcoded install path as fallback
if [ ! -d "$DIR/.venv" ] && [ ! -d "$DIR/libexec/.venv" ]; then
  DIR="$HOME/.local/apps/shellframe"
fi

# Support both regular and Homebrew installs
if [ -d "$DIR/libexec/.venv" ]; then
  cd "$DIR/libexec"
else
  cd "$DIR"
fi

PY_LAUNCHER=".venv/bin/python"
if [ "$(uname)" = "Darwin" ]; then
  REAL_PY="$("$PY_LAUNCHER" -c 'import os,sys; print(os.path.realpath(sys.executable))' 2>/dev/null || true)"
  case "$REAL_PY" in
    */Frameworks/Python.framework/Versions/*/bin/python*)
      PY_APP="${REAL_PY%/bin/python*}/Resources/Python.app/Contents/MacOS/Python"
      if [ -x "$PY_APP" ]; then
        ln -sf "$PY_APP" ".venv/bin/ShellFrame"
        PY_LAUNCHER=".venv/bin/ShellFrame"
      fi
      ;;
  esac
fi

# Force arm64 on Apple Silicon. Without this, if the parent shell happens
# to be Rosetta-translated (Howard's setup) the child python inherits
# x86_64, which gives it bundle id `com.apple.python3` instead of
# com.h2ocloud.shellframe. TCC then refuses NSEvent global monitor
# (Accessibility permission is bound to the .app's identity), so the
# ⌃⌥Space hotkey silently no-ops when shellframe is in the background.
if [[ "$(sysctl -in hw.optional.arm64 2>/dev/null)" == "1" ]]; then
  exec arch -arm64 "$PY_LAUNCHER" main.py "$@"
fi
exec "$PY_LAUNCHER" main.py "$@"
