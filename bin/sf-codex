#!/usr/bin/env bash
set -euo pipefail

# ShellFrame launcher for Codex. Some macOS installs have a Node wrapper that
# runs under x64/Rosetta while only the arm64 Codex optional package is present.
# Prefer the native packaged binary when it exists, then fall back to codex on
# PATH.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Spark 地端模型（config.toml 的 profiles.spark）走 LiteLLM gateway，需要 key。
# 存在 ~/.codex/spark.env 而非這裡，因為本檔在版控內。
if [[ -z "${SPARK_API_KEY:-}" && -r "${HOME}/.codex/spark.env" ]]; then
  # shellcheck source=/dev/null
  source "${HOME}/.codex/spark.env"
fi
export SPARK_API_KEY="${SPARK_API_KEY:-}"

candidates=()

if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
  vendor_rel="@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"

  nvm_root="${NVM_DIR:-${HOME}/.nvm}/versions/node"
  for node_dir in "${nvm_root}"/*; do
    candidates+=("${node_dir}/lib/node_modules/${vendor_rel}")
  done

  if npm_root="$(npm root -g 2>/dev/null)"; then
    candidates+=("${npm_root}/${vendor_rel}")
  fi

  candidates+=(
    "/opt/homebrew/lib/node_modules/${vendor_rel}"
    "/usr/local/lib/node_modules/${vendor_rel}"
  )
fi

candidates+=("${APP_ROOT}/.codex/bin/codex")

for bin in "${candidates[@]}"; do
  if [[ -x "$bin" ]]; then
    exec "$bin" "$@"
  fi
done

exec codex "$@"
