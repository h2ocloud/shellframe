#!/usr/bin/env bash
set -euo pipefail

# ShellFrame launcher for Codex. Some macOS installs have a Node wrapper that
# runs under x64/Rosetta while only the arm64 Codex optional package is present.
# Prefer the native packaged binary when it exists, then fall back to codex on
# PATH.

ROOT="${HOME}/.local/apps/shellframe"

candidates=(
  "${HOME}/.nvm/versions/node/v22.22.2/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"
  "/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"
  "/opt/homebrew/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex"
  "${ROOT}/.codex/bin/codex"
)

for bin in "${candidates[@]}"; do
  if [[ -x "$bin" ]]; then
    exec "$bin" "$@"
  fi
done

exec codex "$@"
